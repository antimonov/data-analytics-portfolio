WITH bonus_group AS (
	SELECT id,
	CASE WHEN count_bonuses_taken > 0 THEN 'с бонусами'
	ELSE 'без бонусов'
	END AS donor_bonus_group
	FROM donorsearch.user_anon_data
)
SELECT bg.donor_bonus_group,
	COUNT(DISTINCT u.id) AS count_donors,
	ROUND(AVG(u.confirmed_donations) :: NUMERIC, 2) AS avg_donations_per_donor
FROM bonus_group AS bg
JOIN donorsearch.user_anon_data AS u ON bg.id = u.id
GROUP BY bg.donor_bonus_group
