WITH planned_donations AS (
	SELECT COUNT(DISTINCT(dp.donation_date, dp.user_id)) AS plan_donations
	FROM donorsearch.donation_plan AS dp
	LEFT JOIN donorsearch.donation_anon AS da ON dp.user_id = da.user_id
	WHERE da.donation_date = dp.donation_date
),
planned_interval_donations AS (
	SELECT COUNT(DISTINCT(dp.donation_date, dp.user_id)) AS plan_donations
	FROM donorsearch.donation_plan AS dp
	LEFT JOIN donorsearch.donation_anon AS da ON dp.user_id = da.user_id
	WHERE da.donation_date BETWEEN dp.donation_date - INTERVAL '7 DAY'
	AND dp.donation_date + INTERVAL '7 DAY'
),
unplanned_donations AS (
	SELECT COUNT(DISTINCT(da.user_id, da.donation_date)) AS plan_donations
	FROM donorsearch.donation_anon AS da
	LEFT JOIN donorsearch.donation_plan AS dp
	 ON da.user_id = dp.user_id 
 	AND da.donation_date BETWEEN dp.donation_date - INTERVAL '7 DAY' AND dp.donation_date + INTERVAL '7 DAY'
	WHERE dp.donation_date IS NULL 
 	AND da.donation_date > '2020-11-20'
 )
 SELECT COUNT(DISTINCT(da.user_id, da.donation_date)) AS всего_донаций,
 		(SELECT pd.plan_donations FROM planned_donations AS pd) AS точное_совпадение_с_планом,
 		(SELECT id.plan_donations FROM planned_interval_donations AS id) AS приблизительное_совпадение,
 		(SELECT ud.plan_donations FROM unplanned_donations AS ud) AS донации_вне_плана		
 FROM donorsearch.donation_anon AS da
 WHERE da.donation_date > '2020-11-20' 
