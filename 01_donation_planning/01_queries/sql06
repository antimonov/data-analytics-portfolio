WITH donor_multi AS (
	SELECT u.id,
	u.confirmed_donations
	FROM donorsearch.user_anon_data AS u
	WHERE confirmed_donations > 1
	GROUP BY u.id, u.confirmed_donations
),
donor_once AS (
	SELECT u.id,
	u.confirmed_donations
	FROM donorsearch.user_anon_data AS u
	WHERE confirmed_donations = 1
	GROUP BY u.id, u.confirmed_donations
)
SELECT SUM(dm.confirmed_donations) AS sum_multi,
	COUNT(dm.id) AS donors_multi_count,
	(SELECT SUM(o.confirmed_donations) FROM donor_once AS o) AS sum_once,
	(SELECT COUNT(o.id) FROM donor_once AS o) AS donor_once_count
FROM donor_multi AS dm
